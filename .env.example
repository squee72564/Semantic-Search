# Local commands derive DATABASE_URL from these PostgreSQL container settings.
POSTGRES_DB=squee_online
POSTGRES_USER=squee_online
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

API_HOST=0.0.0.0
API_PORT=3001
API_INTERNAL_URL=http://localhost:3001
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_SECRET=

# Dedicated non-production S3-compatible bucket. Never reuse production values here.
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

WORKER_POLL_INTERVAL_MS=1000
