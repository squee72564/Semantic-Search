{
  "name": "@repo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {},
  "scripts": {
    "dev": "node ../../tooling/scripts/run-with-env.mjs tsx watch src/index.ts",
    "build": "tsdown",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -b",
    "lint": "oxlint . --report-unused-disable-directives",
    "lint:types": "oxlint --type-aware .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/env": "workspace:*",
    "pino": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "pino-pretty": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
