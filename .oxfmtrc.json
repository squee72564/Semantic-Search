{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "**/.react-router/**",
    "**/.turbo/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/drizzle/meta/**",
    "**/app/components/ui/**",
    "**/node_modules/**",
    "**/playwright-report/**",
    "**/test-results/**",
    "pnpm-lock.yaml"
  ]
}
